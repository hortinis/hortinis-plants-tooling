{
  "name": "@hortinis/plants-tooling",
  "version": "0.0.0",
  "private": true,
  "description": "Schemas and tooling for the Hortinis plant reference catalog.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@11.26.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "11.26.0"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json && node dist/schema/compile-schema-registry.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "typecheck": "tsc --project tsconfig.json",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "verify:curation": "pnpm build && node scripts/run.mjs dist/verification/curation-rehearsal.js",
    "import:grow": "pnpm build && node scripts/run.mjs dist/adapters/grow/cli.js",
    "import:cropgraph": "pnpm build && node scripts/run.mjs dist/adapters/cropgraph/cli.js",
    "import:taxref": "pnpm build && node scripts/run.mjs dist/adapters/taxref/cli.js",
    "import:wfo": "pnpm build && node scripts/run.mjs dist/adapters/wfo/cli.js",
    "reconcile:taxref-wfo": "pnpm build && node scripts/run.mjs dist/curation/taxref-wfo-localization-cli.js",
    "curate:integrated-review": "pnpm build && node scripts/run.mjs dist/curation/integrated-review-packets-cli.js",
    "curate:consolidate": "pnpm build && node scripts/run.mjs dist/curation/plant-review-consolidation-cli.js",
    "curate:drafts": "pnpm build && node scripts/run.mjs dist/curation/curation-cli.js drafts",
    "curate:lookup": "pnpm build && node scripts/run.mjs dist/curation/curation-cli.js lookup",
    "curate:show": "pnpm build && node scripts/run.mjs dist/curation/curation-cli.js show",
    "curate:status": "pnpm build && node scripts/run.mjs dist/curation/curation-cli.js status",
    "curate:validate": "pnpm build && node scripts/run.mjs dist/curation/curation-cli.js validate",
    "verify:taxref-pin": "pnpm build && node scripts/run.mjs dist/adapters/taxref/verify-pin-cli.js",
    "curate:grow-wfo:drafts": "pnpm build && node scripts/run.mjs dist/curation/grow-wfo-drafts-cli.js",
    "curate:wfo:lookup": "pnpm build && node scripts/run.mjs dist/curation/wfo-lookup-cli.js",
    "curate:grow-wfo:validate": "pnpm build && node scripts/run.mjs dist/curation/grow-wfo-validation-cli.js",
    "curate:grow-wfo:status": "pnpm build && node scripts/run.mjs dist/curation/grow-wfo-status-cli.js",
    "curate:grow-wfo:show": "pnpm build && node scripts/run.mjs dist/curation/grow-wfo-show-cli.js",
    "curate:grow-wfo:apply": "pnpm build && node scripts/run.mjs dist/curation/grow-wfo-apply-cli.js",
    "curate:apply": "pnpm build && node scripts/run.mjs dist/curation/curation-cli.js apply",
    "curate:prepare-integration": "pnpm build && node scripts/run.mjs dist/curation/prepare-plant-integration.js",
    "curate:admit-sources": "pnpm build && node scripts/run.mjs dist/curation/supplemental-source-admission.js",
    "curate:admit-assertion": "pnpm build && node scripts/run.mjs dist/curation/supplemental-assertion-admission.js",
    "curate:validate-subject-matches": "pnpm build && node scripts/run.mjs dist/curation/subject-match-validation.js",
    "curate:subject-registry": "pnpm build && node scripts/run.mjs dist/curation/subject-registry.js",
    "curate:admit-subjects": "pnpm build && node scripts/run.mjs dist/curation/canonical-subject-admission.js",
    "curate:saint-etienne-calendar": "pnpm build && node scripts/run.mjs dist/curation/saint-etienne-calendar.js",
    "curate:integration-status": "pnpm build && node scripts/run.mjs dist/curation/plant-integration-status.js",
    "curate:record-reviewed-licensing": "pnpm build && node scripts/run.mjs dist/curation/reviewed-licensing-acceptance.js",
    "curate:admit-legacy-reviews": "pnpm build && node scripts/run.mjs dist/curation/admit-legacy-plant-reviews.js",
    "curate:reviewed-batch": "pnpm build && node scripts/run.mjs dist/curation/reviewed-plant-batch.js",
    "curate:admit-saint-etienne": "pnpm build && node scripts/run.mjs dist/curation/admit-saint-etienne-calendar.js",
    "release:reviewed-catalog": "pnpm build && node scripts/run.mjs dist/artifact/reviewed-catalog.js --check",
    "audit:catalog": "pnpm build && node scripts/run.mjs dist/verification/catalog-audit.js",
    "investigate:schema-fit": "node scripts/run.mjs scripts/schema-fit-assessment.mjs",
    "test:fixtures": "vitest run test/unit test/conformance"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "csv-parse": "^6.2.1",
    "exceljs": "^4.4.0",
    "stream-json": "^3.7.0",
    "unzipper": "0.10.14"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.9.1",
    "prettier": "3.9.6",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.11"
  }
}
