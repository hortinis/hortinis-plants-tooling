{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hortinis:plants:schema:v1:plant-fact",
  "title": "Hortinis catalog plant fact",
  "type": "object",
  "required": [
    "id",
    "status",
    "subject",
    "predicate",
    "value",
    "contextId",
    "evidenceReferenceIds",
    "reviewId"
  ],
  "properties": {
    "id": {
      "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/stableIdentifier"
    },
    "status": {
      "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/catalogStatus"
    },
    "subject": {
      "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/subjectReference"
    },
    "predicate": {
      "type": "string",
      "enum": [
        "life_cycle",
        "cultivar_description",
        "tomato_fruit_type",
        "plant_form_description",
        "horticultural_classification",
        "regulated_seed_eligibility",
        "botanical_scope",
        "taxonomic_source_usage",
        "growth_habit",
        "mature_height",
        "mature_spread",
        "sun_requirement",
        "soil_texture",
        "site_guidance",
        "rotation_classification",
        "harvest_guidance",
        "care_guidance",
        "nutrition_guidance",
        "pollination_guidance",
        "watering_guidance",
        "establishment_guidance",
        "temperature_guidance",
        "soil_ph_range",
        "drainage_requirement",
        "water_requirement",
        "frost_sensitivity",
        "minimum_germination_temperature",
        "germination_profile",
        "growing_temperature",
        "germination_days",
        "days_to_first_harvest",
        "spacing"
      ]
    },
    "value": {},
    "contextId": {
      "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/stableIdentifier"
    },
    "supersedesFactIds": {
      "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/optionalIdentifierList"
    },
    "evidenceReferenceIds": {
      "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/identifierList"
    },
    "reviewId": {
      "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/stableIdentifier"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "predicate": {
            "const": "tomato_fruit_type"
          }
        },
        "required": ["predicate"]
      },
      "then": {
        "properties": {
          "subject": {
            "type": "object",
            "properties": {
              "type": {
                "const": "cultivar"
              }
            }
          },
          "value": {
            "enum": ["cherry", "oxheart"]
          }
        }
      }
    },
    {
      "if": {
        "required": ["predicate"],
        "properties": {
          "predicate": { "const": "horticultural_classification" }
        }
      },
      "then": {
        "properties": {
          "value": {
            "type": "object",
            "additionalProperties": false,
            "required": ["basis", "groups"],
            "properties": {
              "basis": {
                "enum": [
                  "fruiting-pattern",
                  "crop-use",
                  "establishment-and-harvest-season"
                ]
              },
              "groups": {
                "type": "array",
                "minItems": 2,
                "uniqueItems": true,
                "items": {
                  "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/localizedText"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["predicate"],
        "properties": { "predicate": { "const": "regulated_seed_eligibility" } }
      },
      "then": {
        "properties": {
          "value": {
            "type": "object",
            "additionalProperties": false,
            "required": ["scientificName", "alternatives"],
            "properties": {
              "scientificName": { "type": "string", "minLength": 1 },
              "alternatives": {
                "type": "array",
                "minItems": 2,
                "uniqueItems": true,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["selection", "name"],
                  "properties": {
                    "selection": {
                      "enum": ["cultivar-denomination", "conforming-local-type"]
                    },
                    "name": { "type": "string", "minLength": 1 }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "predicate": { "const": "plant_form_description" } },
        "required": ["predicate"]
      },
      "then": {
        "properties": {
          "value": {
            "type": "object",
            "additionalProperties": false,
            "required": ["plantPart", "description"],
            "properties": {
              "plantPart": { "enum": ["flowerhead", "foliage", "fruit"] },
              "description": {
                "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/localizedText"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "predicate": { "const": "cultivar_description" } },
        "required": ["predicate"]
      },
      "then": {
        "properties": {
          "subject": {
            "type": "object",
            "properties": { "type": { "const": "cultivar" } }
          },
          "value": {
            "type": "object",
            "additionalProperties": false,
            "required": ["description"],
            "properties": {
              "description": {
                "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/localizedText"
              },
              "scheme": { "const": "plantdepommedeterre-qualite-culinaire" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "predicate": { "const": "botanical_scope" } },
        "required": ["predicate"]
      },
      "then": {
        "properties": {
          "value": {
            "type": "object",
            "additionalProperties": false,
            "required": ["relation", "scientificName", "sourceIdentifier"],
            "properties": {
              "relation": { "const": "cultivated-scope-within-taxon" },
              "scientificName": { "type": "string", "minLength": 1 },
              "sourceIdentifier": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "predicate": { "const": "taxonomic_source_usage" } },
        "required": ["predicate"]
      },
      "then": {
        "properties": {
          "value": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "relation",
              "scientificName",
              "recordId",
              "acceptedRecordId"
            ],
            "properties": {
              "relation": { "const": "source-treatment-for-scope" },
              "scientificName": { "type": "string", "minLength": 1 },
              "recordId": { "type": "string", "minLength": 1 },
              "acceptedRecordId": { "type": "string", "minLength": 1 },
              "rank": { "type": "string", "minLength": 1 },
              "acceptedName": { "type": "string", "minLength": 1 },
              "sourceVernacular": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "predicate": { "const": "watering_guidance" } },
        "required": ["predicate"]
      },
      "then": {
        "properties": {
          "value": { "$ref": "urn:hortinis:plants:schema:v1:watering-guidance" }
        }
      }
    },
    {
      "if": {
        "properties": { "predicate": { "const": "temperature_guidance" } },
        "required": ["predicate"]
      },
      "then": {
        "properties": {
          "value": {
            "$ref": "urn:hortinis:plants:schema:v1:temperature-guidance"
          }
        }
      }
    },
    {
      "if": {
        "properties": { "predicate": { "const": "establishment_guidance" } },
        "required": ["predicate"]
      },
      "then": {
        "properties": {
          "value": {
            "$ref": "urn:hortinis:plants:schema:v1:establishment-guidance"
          }
        }
      }
    },
    {
      "if": {
        "properties": { "predicate": { "const": "harvest_guidance" } },
        "required": ["predicate"]
      },
      "then": {
        "properties": {
          "value": { "$ref": "urn:hortinis:plants:schema:v1:harvest-guidance" }
        }
      }
    },
    {
      "if": {
        "properties": { "predicate": { "const": "care_guidance" } },
        "required": ["predicate"]
      },
      "then": {
        "properties": {
          "value": { "$ref": "urn:hortinis:plants:schema:v1:care-guidance" }
        }
      }
    },
    {
      "if": {
        "properties": { "predicate": { "const": "nutrition_guidance" } },
        "required": ["predicate"]
      },
      "then": {
        "properties": {
          "value": {
            "$ref": "urn:hortinis:plants:schema:v1:nutrition-guidance"
          }
        }
      }
    },
    {
      "if": {
        "properties": { "predicate": { "const": "pollination_guidance" } },
        "required": ["predicate"]
      },
      "then": {
        "properties": {
          "value": {
            "$ref": "urn:hortinis:plants:schema:v1:pollination-guidance"
          }
        }
      }
    },
    {
      "if": {
        "properties": { "predicate": { "const": "rotation_classification" } },
        "required": ["predicate"]
      },
      "then": {
        "properties": {
          "value": {
            "$ref": "urn:hortinis:plants:schema:v1:rotation-classification"
          }
        }
      }
    },
    {
      "if": {
        "properties": { "predicate": { "const": "site_guidance" } },
        "required": ["predicate"]
      },
      "then": {
        "properties": {
          "value": { "$ref": "urn:hortinis:plants:schema:v1:site-guidance" }
        }
      }
    },
    {
      "if": {
        "properties": { "predicate": { "const": "life_cycle" } },
        "required": ["predicate"]
      },
      "then": {
        "properties": {
          "value": { "enum": ["annual", "biennial", "perennial", "unknown"] }
        }
      }
    },
    {
      "if": {
        "properties": { "predicate": { "const": "growth_habit" } },
        "required": ["predicate"]
      },
      "then": {
        "properties": {
          "value": {
            "enum": [
              "herbaceous",
              "bushy",
              "climbing",
              "creeping",
              "rosette",
              "tree",
              "shrub",
              "unknown"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "predicate": { "enum": ["mature_height", "mature_spread"] }
        },
        "required": ["predicate"]
      },
      "then": {
        "properties": {
          "value": {
            "type": "object",
            "additionalProperties": false,
            "required": ["unit"],
            "properties": {
              "minimum": { "type": "number", "minimum": 0 },
              "maximum": { "type": "number", "exclusiveMinimum": 0 },
              "unit": { "const": "m" }
            },
            "anyOf": [
              { "properties": { "minimum": true }, "required": ["minimum"] },
              { "properties": { "maximum": true }, "required": ["maximum"] }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": { "predicate": { "const": "sun_requirement" } },
        "required": ["predicate"]
      },
      "then": {
        "properties": {
          "value": {
            "oneOf": [
              { "enum": ["full_sun", "partial_shade", "shade", "unknown"] },
              {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": ["full_sun", "partial_shade", "shade", "unknown"]
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": { "predicate": { "const": "soil_texture" } },
        "required": ["predicate"]
      },
      "then": {
        "properties": {
          "value": {
            "oneOf": [
              {
                "enum": [
                  "sand",
                  "loamy_sand",
                  "sandy_loam",
                  "loam",
                  "silt_loam",
                  "silt",
                  "sandy_clay_loam",
                  "clay_loam",
                  "silty_clay_loam",
                  "sandy_clay",
                  "silty_clay",
                  "clay",
                  "unknown"
                ]
              },
              {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "sand",
                    "loamy_sand",
                    "sandy_loam",
                    "loam",
                    "silt_loam",
                    "silt",
                    "sandy_clay_loam",
                    "clay_loam",
                    "silty_clay_loam",
                    "sandy_clay",
                    "silty_clay",
                    "clay",
                    "unknown"
                  ]
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": { "predicate": { "const": "soil_ph_range" } },
        "required": ["predicate"]
      },
      "then": { "properties": { "value": { "$ref": "#/$defs/phRange" } } }
    },
    {
      "if": {
        "properties": { "predicate": { "const": "drainage_requirement" } },
        "required": ["predicate"]
      },
      "then": {
        "properties": {
          "value": {
            "enum": [
              "freely_drained",
              "well_drained",
              "moist_but_drained",
              "poorly_drained",
              "unknown"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": { "predicate": { "const": "water_requirement" } },
        "required": ["predicate"]
      },
      "then": {
        "properties": {
          "value": { "enum": ["low", "moderate", "high", "unknown"] }
        }
      }
    },
    {
      "if": {
        "properties": { "predicate": { "const": "frost_sensitivity" } },
        "required": ["predicate"]
      },
      "then": {
        "properties": {
          "value": { "enum": ["sensitive", "tolerant", "hardy", "unknown"] }
        }
      }
    },
    {
      "if": {
        "properties": {
          "predicate": { "const": "minimum_germination_temperature" }
        },
        "required": ["predicate"]
      },
      "then": { "properties": { "value": { "$ref": "#/$defs/temperature" } } }
    },
    {
      "if": {
        "properties": { "predicate": { "const": "germination_profile" } },
        "required": ["predicate"]
      },
      "then": {
        "properties": {
          "value": {
            "$ref": "urn:hortinis:plants:schema:v1:germination-profile"
          }
        }
      }
    },
    {
      "if": {
        "properties": { "predicate": { "const": "growing_temperature" } },
        "required": ["predicate"]
      },
      "then": {
        "properties": {
          "value": {
            "$ref": "urn:hortinis:plants:schema:v1:temperature-profile"
          }
        }
      }
    },
    {
      "if": {
        "properties": { "predicate": { "const": "germination_days" } },
        "required": ["predicate"]
      },
      "then": { "properties": { "value": { "$ref": "#/$defs/duration" } } }
    },
    {
      "if": {
        "properties": { "predicate": { "const": "days_to_first_harvest" } },
        "required": ["predicate"]
      },
      "then": {
        "properties": { "value": { "$ref": "#/$defs/harvestDuration" } }
      }
    },
    {
      "if": {
        "properties": { "predicate": { "const": "spacing" } },
        "required": ["predicate"]
      },
      "then": {
        "properties": {
          "value": {
            "type": "object",
            "additionalProperties": false,
            "required": ["unit"],
            "properties": {
              "minimum": { "type": "number", "exclusiveMinimum": 0 },
              "maximum": { "type": "number", "exclusiveMinimum": 0 },
              "unit": { "const": "cm" }
            },
            "anyOf": [
              { "properties": { "minimum": true }, "required": ["minimum"] },
              { "properties": { "maximum": true }, "required": ["maximum"] }
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "phRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum"],
      "properties": {
        "minimum": { "type": "number", "minimum": 0, "maximum": 14 },
        "maximum": { "type": "number", "minimum": 0, "maximum": 14 }
      }
    },
    "temperature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": {
        "value": { "type": "number" },
        "unit": { "const": "Cel" }
      }
    },
    "duration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "anchor"],
      "properties": {
        "minimum": { "type": "number", "minimum": 0 },
        "maximum": { "type": "number", "minimum": 0 },
        "unit": { "const": "d" },
        "anchor": {
          "enum": ["after_sowing", "after_stratification", "unknown"]
        }
      },
      "anyOf": [
        { "properties": { "minimum": true }, "required": ["minimum"] },
        { "properties": { "maximum": true }, "required": ["maximum"] }
      ]
    },
    "harvestDuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "anchor"],
      "properties": {
        "minimum": { "type": "number", "minimum": 0 },
        "maximum": { "type": "number", "minimum": 0 },
        "unit": { "const": "d" },
        "anchor": {
          "enum": [
            "after_sowing",
            "after_emergence",
            "after_transplant",
            "after_planting",
            "unknown"
          ]
        },
        "qualifier": {
          "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/localizedText"
        },
        "sourceValue": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimum", "maximum", "unit", "anchor"],
          "properties": {
            "minimum": { "type": "number" },
            "maximum": { "type": "number" },
            "unit": { "const": "d" },
            "anchor": {
              "enum": [
                "after_sowing",
                "after_emergence",
                "after_transplant",
                "after_planting",
                "unknown"
              ]
            }
          }
        },
        "anchorInterpretation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "reviewId", "supportingReferences"],
          "properties": {
            "method": { "const": "curator-approved-inference" },
            "reviewId": {
              "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/stableIdentifier"
            },
            "supportingReferences": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["locator", "sourceVersion", "support", "title"],
                "properties": {
                  "locator": { "type": "string", "minLength": 1 },
                  "sourceVersion": { "type": "string", "minLength": 1 },
                  "support": {
                    "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/localizedText"
                  },
                  "title": {
                    "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/localizedText"
                  }
                }
              }
            }
          }
        }
      },
      "anyOf": [
        { "properties": { "minimum": true }, "required": ["minimum"] },
        { "properties": { "maximum": true }, "required": ["maximum"] }
      ]
    }
  }
}
