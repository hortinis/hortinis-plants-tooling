{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hortinis:plants:schema:curation:v1:plant-review-proposal",
  "title": "Draft autonomous plant review proposal; not curator approval or catalog admission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "policyVersion",
    "id",
    "revision",
    "status",
    "researchComplete",
    "curatorApproval",
    "catalogIntegration",
    "createdAt",
    "baseline",
    "plant",
    "scopes",
    "evidence",
    "claims",
    "sourceCandidateDispositions",
    "coverage",
    "questions",
    "checks"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "policyVersion": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^(pr|ps|pc|pe|pq|pa)_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "const": "in progress"
    },
    "researchComplete": {
      "type": "boolean"
    },
    "curatorApproval": {
      "type": "null"
    },
    "catalogIntegration": {
      "const": "planned"
    },
    "createdAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "dirty", "notes"],
      "properties": {
        "commit": {
          "type": "string",
          "minLength": 1
        },
        "dirty": {
          "type": "boolean"
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "plant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "scientificName",
        "catalogSubjectId",
        "targetGeography",
        "scopeNotes"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "scientificName": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "catalogSubjectId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "targetGeography": {
          "type": "string",
          "minLength": 1
        },
        "scopeNotes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "kind",
          "catalogSubjectId",
          "parentScopeId"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(pr|ps|pc|pe|pq|pa)_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": ["generic", "growing-type", "cultivar"]
          },
          "catalogSubjectId": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "parentScopeId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(pr|ps|pc|pe|pq|pa)_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "sourceId",
          "release",
          "sourceRecord",
          "locator",
          "url",
          "observedAt",
          "originalValue",
          "notes",
          "rights",
          "capture"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(pr|ps|pc|pe|pq|pa)_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "sourceId": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "release": {
            "type": "string",
            "minLength": 1
          },
          "sourceRecord": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "observedAt": {
            "type": "string",
            "minLength": 1
          },
          "originalValue": {},
          "notes": {
            "type": "string",
            "minLength": 1
          },
          "rights": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "licence",
              "licenceUrl",
              "status",
              "commercialUseAllowed",
              "upstreamChecked",
              "attribution",
              "notes"
            ],
            "properties": {
              "licence": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "licenceUrl": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "status": {
                "enum": ["planned", "in progress", "validated", "blocked"]
              },
              "commercialUseAllowed": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "upstreamChecked": {
                "type": "boolean"
              },
              "attribution": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "notes": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "capture": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "path", "sha256"],
            "properties": {
              "kind": {
                "enum": ["source-document", "review-extract", "reference-only"]
              },
              "path": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "sha256": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "domain",
          "topic",
          "scopeIds",
          "value",
          "evidenceIds",
          "recommendation",
          "reason",
          "interpretation",
          "conditions",
          "implementation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(pr|ps|pc|pe|pq|pa)_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "domain": {
            "enum": [
              "identity",
              "temperature",
              "planting",
              "environment",
              "water",
              "nutrition",
              "harvest",
              "care"
            ]
          },
          "topic": {
            "type": "string",
            "minLength": 1
          },
          "scopeIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(pr|ps|pc|pe|pq|pa)_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            }
          },
          "value": {},
          "replaces": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["key", "packetSha256"],
              "properties": {
                "key": {
                  "type": "string",
                  "pattern": "^pr_[0-9a-f-]{36}:pc_[0-9a-f-]{36}$"
                },
                "packetSha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          },
          "evidenceIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(pr|ps|pc|pe|pq|pa)_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            }
          },
          "recommendation": {
            "enum": ["select", "alternative", "defer", "exclude"]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "interpretation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "notes"],
            "properties": {
              "kind": {
                "enum": [
                  "source-explicit",
                  "unit-conversion",
                  "curator-inference"
                ]
              },
              "notes": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "conditions": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "measurementMedium",
              "lifeStage",
              "eventAnchor",
              "geography",
              "growingSystem",
              "qualifications"
            ],
            "properties": {
              "measurementMedium": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "lifeStage": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "eventAnchor": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "geography": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "growingSystem": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "qualifications": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "implementation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["predicate", "status", "notes"],
            "properties": {
              "predicate": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "status": {
                "enum": ["planned", "in progress", "validated", "blocked"]
              },
              "notes": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "sourceCandidateDispositions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceId",
          "release",
          "sourceRecord",
          "locator",
          "claimIds",
          "disposition",
          "reason"
        ],
        "properties": {
          "sourceId": {
            "type": "string",
            "minLength": 1
          },
          "release": {
            "type": "string",
            "minLength": 1
          },
          "sourceRecord": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "claimIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(pr|ps|pc|pe|pq|pa)_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            }
          },
          "disposition": {
            "enum": ["proposed", "alternative", "deferred", "excluded"]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "coverage": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["domain", "outcome", "claimIds", "reason"],
        "properties": {
          "domain": {
            "enum": [
              "identity",
              "temperature",
              "planting",
              "environment",
              "water",
              "nutrition",
              "harvest",
              "care"
            ]
          },
          "outcome": {
            "enum": ["proposed", "unresolved", "not-applicable"]
          },
          "claimIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(pr|ps|pc|pe|pq|pa)_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "domain",
          "question",
          "researchAttempts",
          "stoppingReason",
          "resolutionNeeded"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(pr|ps|pc|pe|pq|pa)_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "status": {
            "enum": ["planned", "in progress", "validated", "blocked"]
          },
          "domain": {
            "enum": [
              "identity",
              "temperature",
              "planting",
              "environment",
              "water",
              "nutrition",
              "harvest",
              "care"
            ]
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "researchAttempts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "stoppingReason": {
            "type": "string",
            "minLength": 1
          },
          "resolutionNeeded": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "details"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": ["planned", "in progress", "validated", "blocked"]
          },
          "details": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
