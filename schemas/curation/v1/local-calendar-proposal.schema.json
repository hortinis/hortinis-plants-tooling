{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hortinis:plants:schema:curation:v1:local-calendar-proposal",
  "title": "Hortinis local calendar proposal batch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "revision",
    "status",
    "curatorApproval",
    "commercialRelease",
    "inventoryFingerprint",
    "bordeauxRowsSha256",
    "inputPins",
    "geography",
    "evidence",
    "qualifiers",
    "identities",
    "existingSubjectMappings",
    "windows",
    "baselineAssertions"
  ],
  "properties": {
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "const": "in progress"
    },
    "curatorApproval": {
      "const": null
    },
    "commercialRelease": {
      "const": "blocked"
    },
    "inventoryFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "bordeauxRowsSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "inputPins": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "geography": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "communeCode", "coverage", "limitations"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "communeCode": {
          "type": "string",
          "pattern": "^[0-9]{5}$"
        },
        "coverage": {
          "type": "string",
          "minLength": 1
        },
        "limitations": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "record",
          "release",
          "locator",
          "url",
          "observedAt",
          "capture",
          "observations",
          "rights"
        ],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "record": {
            "type": "string",
            "minLength": 1
          },
          "release": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "observedAt": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "capture": {
            "const": "reference-only"
          },
          "observations": {
            "type": "string",
            "minLength": 1
          },
          "rights": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "commercialUseAllowed",
              "notes",
              "references"
            ],
            "properties": {
              "status": {
                "const": "in progress"
              },
              "commercialUseAllowed": {
                "const": null
              },
              "notes": {
                "type": "string",
                "minLength": 1
              },
              "references": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^https://"
                }
              }
            }
          }
        }
      }
    },
    "qualifiers": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "identities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "basis",
          "label",
          "scientificName",
          "kind",
          "identityClaimIds",
          "rationale"
        ],
        "properties": {
          "basis": {
            "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/stableIdentifier"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "scientificName": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": ["generic", "growing-type"]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "parentBasis": {
            "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/stableIdentifier"
          },
          "identityClaimIds": {
            "type": "array",
            "uniqueItems": true,
            "minItems": 1,
            "items": {
              "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/stableIdentifier"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "growing-type"
                }
              }
            },
            "then": {
              "required": ["parentBasis"],
              "properties": {
                "parentBasis": true
              }
            },
            "else": {
              "not": {
                "required": ["parentBasis"]
              }
            }
          }
        ]
      },
      "uniqueItems": true
    },
    "existingSubjectMappings": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["basis", "subjectId", "rationale"],
        "properties": {
          "basis": {
            "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/stableIdentifier"
          },
          "subjectId": {
            "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/stableIdentifier"
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "uniqueItems": true
    },
    "windows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claims",
          "action",
          "season",
          "requirements",
          "threshold",
          "evidence",
          "method",
          "confidence",
          "limitations"
        ],
        "properties": {
          "claims": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/stableIdentifier"
            },
            "uniqueItems": true
          },
          "action": {
            "enum": ["establish_outdoors", "transplant", "direct_sow"]
          },
          "season": {
            "enum": [
              "early-to-mid-spring",
              "late-spring-to-early-summer",
              "early-summer",
              "mid-to-late-spring",
              "late-summer-to-early-autumn",
              "spring-to-early-summer"
            ]
          },
          "requirements": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "workable",
                "warming",
                "frost",
                "hardening",
                "warm-soil",
                "sunny-sheltered",
                "milder-spring",
                "heat-abated",
                "season-remaining",
                "spring-material",
                "outdoor-variety",
                "rooted-transplants"
              ]
            },
            "uniqueItems": true
          },
          "threshold": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["medium", "operator", "value", "unit"],
                "properties": {
                  "medium": {
                    "const": "soil"
                  },
                  "operator": {
                    "const": "at-least"
                  },
                  "value": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "unit": {
                    "const": "Cel"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["medium", "operator", "value", "unit"],
                "properties": {
                  "medium": {
                    "const": "air"
                  },
                  "operator": {
                    "const": "reliably-above"
                  },
                  "value": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "unit": {
                    "const": "Cel"
                  }
                }
              }
            ]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "enum": ["moderate", "low"]
          },
          "limitations": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "uniqueItems": true
    },
    "baselineAssertions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ids", "sha256"],
      "properties": {
        "ids": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 1,
          "items": {
            "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/stableIdentifier"
          }
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  },
  "$defs": {
    "consumerPreview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "subject",
        "contextId",
        "communeCode",
        "action",
        "season",
        "requirements",
        "threshold",
        "inheritance",
        "status",
        "commercialRelease"
      ],
      "properties": {
        "id": {
          "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/stableIdentifier"
        },
        "subject": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "id"],
          "properties": {
            "type": {
              "const": "plant-concept"
            },
            "id": {
              "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/stableIdentifier"
            }
          }
        },
        "contextId": {
          "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/stableIdentifier"
        },
        "communeCode": {
          "type": "string",
          "pattern": "^[0-9]{5}$"
        },
        "action": {
          "enum": ["establish_outdoors", "transplant", "direct_sow"]
        },
        "season": {
          "enum": [
            "early-to-mid-spring",
            "late-spring-to-early-summer",
            "early-summer",
            "mid-to-late-spring",
            "late-summer-to-early-autumn",
            "spring-to-early-summer"
          ]
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "workable",
              "warming",
              "frost",
              "hardening",
              "warm-soil",
              "sunny-sheltered",
              "milder-spring",
              "heat-abated",
              "season-remaining",
              "spring-material",
              "outdoor-variety",
              "rooted-transplants"
            ]
          },
          "uniqueItems": true
        },
        "threshold": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["medium", "operator", "value", "unit"],
              "properties": {
                "medium": {
                  "const": "soil"
                },
                "operator": {
                  "const": "at-least"
                },
                "value": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "unit": {
                  "const": "Cel"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["medium", "operator", "value", "unit"],
              "properties": {
                "medium": {
                  "const": "air"
                },
                "operator": {
                  "const": "reliably-above"
                },
                "value": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "unit": {
                  "const": "Cel"
                }
              }
            }
          ]
        },
        "inheritance": {
          "const": "exact-subject-only"
        },
        "status": {
          "const": "in progress"
        },
        "commercialRelease": {
          "const": "blocked"
        }
      }
    }
  }
}
